generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(180)
  password  String   @db.VarChar(255)
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  fullName    String   @map("full_name") @db.VarChar(140)
  headline    String   @db.VarChar(180)
  bio         String   @db.Text
  email       String   @unique @db.VarChar(180)
  phone       String?  @db.VarChar(40)
  location    String?  @db.VarChar(120)
  githubUrl   String?  @map("github_url") @db.VarChar(255)
  linkedinUrl String?  @map("linkedin_url") @db.VarChar(255)
  cvUrl       String?  @map("cv_url") @db.VarChar(255)
  photoUrl    String?  @map("photo_url") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Project {
  id           String             @id @default(uuid()) @db.Uuid
  title        String             @db.VarChar(160)
  slug         String             @unique @db.VarChar(180)
  summary      String             @db.VarChar(280)
  description  String             @db.Text
  problem      String             @db.Text
  solution     String             @db.Text
  impact       String             @db.Text
  imageUrl     String?            @map("image_url") @db.VarChar(255)
  demoUrl      String?            @map("demo_url") @db.VarChar(255)
  githubUrl    String?            @map("github_url") @db.VarChar(255)
  isFeatured   Boolean            @default(false) @map("is_featured")
  displayOrder Int                @default(0) @map("display_order")
  techStacks   ProjectTechStack[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([isFeatured, displayOrder])
  @@index([displayOrder])
  @@map("projects")
}

model Skill {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(100)
  category     String     @db.VarChar(100)
  level        SkillLevel @default(INTERMEDIATE)
  displayOrder Int        @default(0) @map("display_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([name, category])
  @@index([category, displayOrder])
  @@map("skills")
}

model TechStack {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @unique @db.VarChar(100)
  category     String             @db.VarChar(100)
  displayOrder Int                @default(0) @map("display_order")
  projects     ProjectTechStack[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([category, displayOrder])
  @@map("tech_stacks")
}

model ProjectTechStack {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  techStackId String    @map("tech_stack_id") @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  techStack   TechStack @relation(fields: [techStackId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([projectId, techStackId])
  @@index([techStackId])
  @@map("project_tech_stacks")
}

model Experience {
  id           String    @id @default(uuid()) @db.Uuid
  company      String    @db.VarChar(160)
  role         String    @db.VarChar(160)
  location     String?   @db.VarChar(120)
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  isCurrent    Boolean   @default(false) @map("is_current")
  description  String    @db.Text
  achievements String[]  @default([])
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([company, role, startDate])
  @@index([isCurrent, startDate])
  @@index([displayOrder])
  @@map("experiences")
}

model ContactMessage {
  id        String               @id @default(uuid()) @db.Uuid
  name      String               @db.VarChar(120)
  email     String               @db.VarChar(180)
  subject   String?              @db.VarChar(180)
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([email])
  @@map("contact_messages")
}
